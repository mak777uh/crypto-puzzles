:"#aj73v_mobile_bg","isPreset":false,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false}},"aj73v_desktop_bg":{"type":"BackgroundMedia","id":"aj73v_desktop_bg","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"x0h-146"},"mediaRef":"#aj73v_desktop_mediaRef","color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"aj73v_desktop_mediaRef":{"type":"Image","id":"aj73v_desktop_mediaRef","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"x0h-149"},"title":"giphy.gif","uri":"144728_e97be91711254741999d9cc38f9644da~mv2.gif","description":"private","width":400,"height":400,"alt":"","artist":{"id":"","name":""}},"aj73v_mobile_bg":{"type":"BackgroundMedia","id":"aj73v_mobile_bg","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"x0h-147"},"mediaRef":"#aj73v_mobile_mediaRef","color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fixed","colorOverlay":"","colorOverlayOpacity":0.0},"aj73v_mobile_mediaRef":{"type":"Image","id":"aj73v_mobile_mediaRef","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"x0h-148"},"title":"giphy.gif","uri":"144728_e97be91711254741999d9cc38f9644da~mv2.gif","description":"private","width":400,"height":400,"alt":"","artist":{"id":"","name":""}},"dataItem-l5fsxay2":{"type":"StyledText","id":"dataItem-l5fsxay2","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"75v-474"},"text":"<h3 class=\"font_3\" style=\"line-height:normal; text-align:center\"><span style=\"letter-spacing:normal\"><span class=\"color_15\"><span style=\"font-family:didot-w01-italic,serif\">The mystery begins...</span></span></span></h3>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-l5fsxayb1":{"type":"StyledText","id":"dataItem-l5fsxayb1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"mo5-2085"},"text":"<h6 class=\"font_6\" style=\"line-height:normal; text-align:center\"><span class=\"backcolor_21\"><span style=\"color:rgb(32, 206, 136); font-family:didot-w01-italic,didot-w05-italic,serif\">You land in the sea. Your ship, Poseidon, is close by. You swim to it.</span><br />\n<br />\n<span style=\"color:rgb(32, 206, 136); font-family:didot-w01-italic,didot-w05-italic,serif\">Why didn&#39;t she come to get you?</span><br />\n<br />\n<span style=\"color:rgb(32, 206, 136); font-family:didot-w01-italic,didot-w05-italic,serif\">You can hear and feel the hum of the engine as you climb aboard. &nbsp;You smell salt water, engine fumes... and garlic. You move into the cabin, and see a table fully set. Glittery letters, strung over the table, read: Welcome Home. Candles are lit on the table. Only a bit of wax has dripped off of them. They weren&#39;t lit long ago.<br />\nOn the stove, still being warmed by a flame, sits your favorite meal &mdash; cooked by the one you love.</span><br />\n<br />\n<span style=\"color:rgb(32, 206, 136); font-family:didot-w01-italic,didot-w05-italic,serif\">But she is not aboard. Nobody is aboard. The ship is completely empty.&nbsp;</span><br />\n<br />\n<span style=\"color:rgb(32, 206, 136); font-family:didot-w01-italic,didot-w05-italic,serif\">You search for binoculars in a drawer and then climb to the top of the ship and put them to your eyes. You see the sea. In front of you, to your sides, behind you, the sea. The sea and nothing else. </span><br />\n<br />\n<span style=\"color:rgb(32, 206, 136); font-family:didot-w01-italic,didot-w05-italic,serif\">This is a search and rescue mission for the one you love.</span><br />\n<br />\n<span style=\"color:rgb(32, 206, 136); font-family:didot-w01-italic,didot-w05-italic,serif\">To begin, chart a course.</span></span></h6>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-l5fsxayd2":{"type":"StylableButton","id":"dataItem-l5fsxayd2","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"w2m-166"},"label":"Chart a Course","svgId":"b861b040274141de9c08999ec3b76edf.svg","link":"#dataItem-l5fufi9z"},"dataItem-l5ft6ht1":{"type":"Image","id":"dataItem-l5ft6ht1","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"ibm-371"},"title":"","uri":"144728_767b7595759e4fe3a02e01042e7c9ea6~mv2.jpg","description":"","width":533,"height":320,"alt":"The Poseidon.jpg","name":"The Poseidon.jpg","link":"#dataItem-l5gak2xa"},"dataItem-l5fu3n11":{"type":"StyledText","id":"dataItem-l5fu3n11","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"w2m-527"},"text":"<h6 class=\"font_6\" style=\"line-height:normal; text-align:center\"><span style=\"letter-spacing:normal\"><span style=\"color:#BD1515\"><span style=\"font-family:courier new,courier-ps-w01,courier-ps-w02,courier-ps-w10,monospace\"><span style=\"background-color:#B08484\">latitude (numbers only)</span></span></span></span></h6>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":[]},"dataItem-l5fufi9z":{"type":"PageLink","id":"dataItem-l5fufi9z","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"w2m-167"},"pageId":"#oq7la","target":"_self","rel":[]},"dataItem-l5gak2xa":{"type":"ExternalLink","id":"dataItem-l5gak2xa","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"ibm-372"},"url":"https://static.wixstatic.com/media/144728_767b7595759e4fe3a02e01042e7c9ea6~mv2.jpg","target":"_blank","rel":["noreferrer","noopener"]},"dataItem-l5unweua":{"type":"StyledText","id":"dataItem-l5unweua","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"mo5-2769"},"text":"<h3 class=\"font_3\"><a dataquery=\"#textLink_l5uo5xd8\"><span style=\"color:#FF4040;\"><span style=\"text-decoration:underline;\"><span style=\"font-style:normal\"><span style=\"font-family:georgia,palatino,book antiqua,palatino linotype,serif\"><span style=\"font-weight:normal\"><span style=\"font-size:23px\"><span class=\"backcolor_21\"><span style=\"font-family: didot-w01-italic, didot-w05-italic, serif;\">I&#39;m really confused</span></span></span></span></span></span></span></span></a></h3>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":["#textLink_l5uo5xd8"]},"textLink_l5uo5xd8":{"type":"PageLink","id":"textLink_l5uo5xd8","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"mo5-2770"},"pageId":"#ay4p6","target":"_self","rel":[]}},"design_data":{},"behaviors_data":{},"connections_data":{"aj73v":{"type":"ConnectionList","id":"aj73v","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"75v-114"},"items":[{"type":"WixCodeConnectionItem","role":"page1"}]},"connection-l5fsxay6":{"type":"ConnectionList","id":"connection-l5fsxay6","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"75v-119"},"items":[{"type":"WixCodeConnectionItem","role":"text16"}]},"connection-l5fsxayc":{"type":"ConnectionList","id":"connection-l5fsxayc","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"75v-134"},"items":[{"type":"WixCodeConnectionItem","role":"text19"}]},"connection-l5fsxayk":{"type":"ConnectionList","id":"connection-l5fsxayk","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"75v-146"},"items":[{"type":"WixCodeConnectionItem","role":"button7"}]},"connection-l5ft6htc":{"type":"ConnectionList","id":"connection-l5ft6htc","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"75v-438"},"items":[{"type":"WixCodeConnectionItem","role":"image1"}]},"connection-l5fu3n1h":{"type":"ConnectionList","id":"connection-l5fu3n1h","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"75v-2416"},"items":[{"type":"WixCodeConnectionItem","role":"text21"}]},"connection-l5unweuj":{"type":"ConnectionList","id":"connection-l5unweuj","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"mo5-2089"},"items":[{"type":"WixCodeConnectionItem","role":"text22