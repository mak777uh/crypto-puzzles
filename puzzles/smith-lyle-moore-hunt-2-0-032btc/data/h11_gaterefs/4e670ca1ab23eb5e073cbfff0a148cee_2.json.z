{"structure":{"type":"Page","styleId":"p1","metaData":{"sig":"pkd-203"},"id":"epndr","components":[{"type":"Component","styleId":"txtTheme","metaData":{"sig":"57o-90"},"id":"comp-l5umpzqh","dataQuery":"#dataItem-l5umpzqh1","skin":"wysiwyg.viewer.skins.WRichTextThemeSkin","layout":{"width":846,"height":936,"x":66,"y":22,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-l5umpzqk","connectionQuery":"connection-l5umpzql","componentType":"wysiwyg.viewer.components.WRichText"},{"type":"Component","styleId":"style-l5un9dq4","metaData":{"sig":"mo5-3159"},"id":"comp-l5un9dop","dataQuery":"#dataItem-l5un9dpt","skin":"wixui.skins.Skinless","layout":{"width":287,"height":40,"x":346,"y":676,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-l5un9dpz","connectionQuery":"connection-l5un9dq6","componentType":"wixui.StylableButton"}],"mobileComponents":[{"type":"Component","styleId":"txtTheme","metaData":{"sig":"57o-106"},"id":"comp-l5umpzqh","dataQuery":"#dataItem-l5umpzqh1","skin":"wysiwyg.viewer.skins.WRichTextNewSkin","layout":{"width":280,"height":1524,"x":19,"y":10,"scale":0.7692307692307693,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"mobile_propItem-l5umpzqk","connectionQuery":"connection-l5umpzql","componentType":"wysiwyg.viewer.components.WRichText"},{"type":"Component","styleId":"style-l5un9dq4","metaData":{"sig":"mo5-3841"},"id":"comp-l5un9dop","dataQuery":"#dataItem-l5un9dpt","skin":"wixui.skins.Skinless","layout":{"width":270,"height":42,"x":25,"y":1117,"scale":0.9333333333333333,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"propItem-l5un9dpz","connectionQuery":"connection-l5un9dq6","componentType":"wixui.StylableButton"}],"mobileMetaData":{"sig":"fz2-1150"},"dataQuery":"#epndr","skin":"wysiwyg.viewer.skins.page.TransparentPageSkin","layout":{"width":1410,"height":958,"x":0,"y":0,"scale":1.0,"rotationInDegrees":0.0,"fixedPosition":false},"propertyQuery":"epndr","mobileHintsQuery":"epndr","connectionQuery":"epndr","componentType":"mobile.core.components.Page","fixerVersionsQuery":"epndr"},"data":{"document_data":{"dataItem-l5umpzqh1":{"type":"StyledText","id":"dataItem-l5umpzqh1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"57o-96"},"text":"<p class=\"font_8\" style=\"font-size:22px; line-height:normal\"><span style=\"letter-spacing:normal\"><span style=\"font-size:22px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span class=\"backcolor_28\">In the spirit of many epic sea voyages, we&rsquo;ve diverted a large chunk (for an indie band) of our advertising budget to help you on a psychedelic journey across the sea. Woven into our next single, Glimmer, is a story. Uncover the story... it will lead you to .031777 Bitcoin.</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"font-size:27px; line-height:normal\"><span style=\"letter-spacing:normal\"><span style=\"font-size:27px\"><span style=\"font-family:didot-w01-italic,serif\"><span class=\"wixGuard\">​</span></span></span></span></p>\n\n<p class=\"font_8\" style=\"font-size:21px; line-height:normal\"><span style=\"letter-spacing:normal\"><span style=\"font-size:21px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span style=\"color:#20CE88\"><span class=\"backcolor_21\">A couple more important pieces of info:</span></span></span></span></span></p>\n\n<ol class=\"font_8\" style=\"color:rgb(32, 206, 136); font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter; font-size:21px\">\n\t<li style=\"line-height:normal\">\n\t<p class=\"font_8\" style=\"font-size:21px; line-height:normal\"><span style=\"letter-spacing:normal\"><span style=\"font-size:21px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span style=\"color:#FF4040\"><span style=\"text-decoration:underline\"><span class=\"backcolor_21\"><a dataquery=\"#textLink_l5umwmi6\">P</a></span></span><span class=\"backcolor_21\"><span style=\"text-decoration:underline\"><a dataquery=\"#textLink_l5umwmi6\">resave Glimmer</a></span></span></span><span style=\"color:#20CE88\"><span class=\"backcolor_21\"> and we&#39;ll help you solve the first puzzle in an email on release day.</span></span></span></span></span></p>\n\t</li>\n\t<li style=\"line-height:normal\">\n\t<p class=\"font_8\" style=\"font-size:21px; line-height:normal\"><span style=\"letter-spacing:normal\"><span style=\"font-size:21px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span style=\"color:#20CE88\"><span class=\"backcolor_21\">This is a digital treasure hunt. The treasure is buried with riddles, cyphers, analogies and references to historical events or epic nautical stories. </span></span></span></span></span></p>\n\t</li>\n\t<li style=\"line-height:normal\">\n\t<p class=\"font_8\" style=\"font-size:21px; line-height:normal\"><span style=\"letter-spacing:normal\"><span style=\"font-size:21px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span style=\"color:#20CE88\"><span class=\"backcolor_21\">There are red herrings and incorrect paths. Some lead back to the main journey, some lead elsewhere.</span></span></span></span></span></p>\n\t</li>\n\t<li style=\"line-height:normal\">\n\t<p class=\"font_8\" style=\"font-size:21px; line-height:normal\"><span style=\"letter-spacing:normal\"><span style=\"font-size:21px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span style=\"color:#20CE88\"><span class=\"backcolor_21\">The nature of a treasure hunt encourages keeping it a secret... but share this hunt on reddit (comments or posts), and/or tag your friends on social media and show us, and we will reward you for helping us spread the word.</span></span></span></span></span><span style=\"letter-spacing:normal\"><span style=\"font-size:21px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span style=\"color:#20CE88\"><span class=\"backcolor_21\">​</span></span></span></span></span></p>\n\t</li>\n\t<li style=\"line-height:normal\">\n\t<p class=\"font_8\" style=\"font-size:21px; line-height:normal\"><span style=\"letter-spacing:normal\"><span style=\"font-size:21px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span style=\"color:#20CE88\"><span class=\"backcolor_21\">This is the second digital treasure hunt we&#39;ve created, and it picks up where the last one left off. Watch the <span style=\"text-decoration:underline\"><a dataquery=\"#link-l5umpzqr6\">Born to Be Wild video</a></span> to better understand where you are starting from. And a word of advice: all of our finalists in the last treasure hunt were groups of people. The journey is more fun shared with others.</span></span></span></span></span></p>\n\t</li>\n\t<li style=\"line-height:normal\">\n\t<p class=\"font_8\" style=\"font-size:21px; line-height:normal\"><span style=\"letter-spacing:normal\"><span style=\"font-size:21px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span style=\"color:#20CE88\"><span class=\"backcolor_21\">Lots of questions will been answered and hints given on our subreddit: </span></span><span style=\"color:#F7B700\"><span class=\"backcolor_21\"><a dataquery=\"#link-l5umpzqr4\"><span style=\"font-size:21px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span style=\"text-decoration:underline\"><span class=\"backcolor_21\">reddit.com/r/smithlylemoore&nbsp;</span></span></span></span></a></span></span></span></span></span></p>\n\t</li>\n</ol>\n\n<p class=\"font_8\" style=\"font-size:21px; line-height:normal\"><span style=\"letter-spacing:normal\"><span style=\"font-size:21px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span style=\"color:#F7B700\"><span class=\"backcolor_21\"><span style=\"font-size:21px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span style=\"text-decoration:underline\"><span class=\"wixGuard\">​</span></span></span></span></span></span></span></span></span></p>\n\n<p class=\"font_8\" style=\"font-size:21px; line-height:normal\"><span style=\"letter-spacing:normal\"><span style=\"font-size:21px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span style=\"color:#F7B700\"><span class=\"backcolor_21\"><span style=\"font-size:21px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span style=\"text-decoration:underline\"><span class=\"wixGuard\">​</span></span></span></span></span></span></span></span></span></p>\n\n<p class=\"font_8\" style=\"font-size:21px; line-height:normal\"><span style=\"letter-spacing:normal\"><span style=\"font-size:21px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span style=\"color:#F7B700\"><span class=\"backcolor_21\"><span style=\"font-size:21px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span style=\"text-decoration:underline\"><span class=\"wixGuard\">​</span></span></span></span></span></span></span></span></span></p>\n\n<p class=\"font_8\" style=\"font-size:21px; line-height:normal\"><span style=\"letter-spacing:normal\"><span style=\"font-size:21px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span style=\"color:#F7B700\"><span class=\"backcolor_21\"><span style=\"font-size:21px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span style=\"text-decoration:underline\"><span class=\"wixGuard\">​</span></span></span></span></span></span></span></span></span></p>\n\n<p class=\"font_8\" style=\"font-size:27px; line-height:normal\">&nbsp;</p>\n\n<p class=\"font_8\" style=\"font-size:27px; line-height:normal\"><span style=\"letter-spacing:normal\"><span style=\"font-size:25px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><a dataquery=\"#link-l5umpzqr1\"><span style=\"font-size:25px\"><span style=\"font-family:wfont_d2b11b_a1025f0f94144f67af07afa1cbf4edd2,wf_a1025f0f94144f67af07afa1c,orig_tox_typewriter\"><span style=\"background-color:#7342B2\">In rainbow road on N64, if you speed boost at the beginning and fly off </span><span style=\"background-color:#4269B2\">track to the left (with precision), you can be taken on a large shortcut. </span></span></span></a><span style=\"background-color:#4269B2\">There</span><span class=\"backcolor_28\"> </span><span style=\"background-color:#1F9566\">is also a shortcut in this journey if you know where/how to look and are </span><span style=\"background-color:#BADA55\">willing to take the baby steps that lead to one giant leap. We will answer </span><span style=\"background-color:#DB741A\">some questions, publicly, if it is taking too long for you to figure it out. No </span><span class=\"backcolor_28\">questions will be answered regarding the shortcut. </span></span></span></span></p>","stylesMapId":"CK_EDITOR_PARAGRAPH_STYLES","linkList":["#link-l5umpzqr1","#link-l5umpzqr4","#link-l5umpzqr6","#textLink_l5umwmi6"]},"dataItem-l5un9dpt":{"type":"StylableButton","id":"dataItem-l5un9dpt","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"mo5-1216"},"label":"I Be The Ruler of the Seven Seas","svgId":"b861b040274141de9c08999ec3b76edf.svg","link":"#dataItem-l5un9dpt1"},"dataItem-l5un9dpt1":{"type":"PageLink","id":"dataItem-l5un9dpt1","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"mo5-1217"},"pageId":"#wsbja","target":"_self","rel":[]},"epndr":{"type":"Page","id":"epndr","metaData":{"isPreset":false,"schemaVersion":"2.0","isHidden":false,"sig":"81f-92"},"title":"More Info","hideTitle":true,"icon":"","descriptionSEO":"Smith, Lyle & Moore's Treasure Hunt. The first person to to solve the puzzle, wins the treasure: .025 Bitcoin.","metaKeywordsSEO":"","pageTitleSEO":"Smith, Lyle & Moore","pageUriSEO":"more-info","hidePage":true,"isMobileLandingPage":false,"underConstruction":false,"tpaApplicationId":0,"pageSecurity":{"requireLogin":false},"isPopup":false,"indexable":true,"isLandingPage":false,"pageBackgrounds":{"desktop":{"custom":true,"ref":"#epndr_desktop_bg","isPreset":true},"mobile":{"custom":true,"ref":"#epndr_mobile_bg","isPreset":false,"mediaSizing":"viewport"}},"translationData":{"uriSEOTranslated":false},"advancedSeoData":"{\"tags\":[{\"type\":\"title\",\"children\":\"Smith, Lyle & Moore\"},{\"type\":\"meta\",\"props\":{\"name\":\"description\",\"content\":\"Smith, Lyle & Moore's Treasure Hunt. The first person to to solve the puzzle, wins the treasure: .025 Bitcoin.\"}},{\"type\":\"meta\",\"props\":{\"name\":\"robots\",\"content\":\"noindex\"}}]}"},"epndr_desktop_bg":{"type":"BackgroundMedia","id":"epndr_desktop_bg","metaData":{"isPreset":false,"schemaVersion":"1.0","isHidden":false,"sig":"x0h-24"},"mediaRef":"#epndr_desktop_mediaRef","color":"{color_11}","alignType":"center","fittingType":"fill","scrollType":"fix